(set-logic QF_AUFBV)
(set-info :status sat)
(declare-const A (Array (_ BitVec 8) (_ BitVec 8)))
(declare-const i0 (_ BitVec 8))
(declare-const i1 (_ BitVec 8))
(declare-const i2 (_ BitVec 8))
(declare-const v0 (_ BitVec 8))
(declare-const v1 (_ BitVec 8))
(declare-fun h ((_ BitVec 8)) (_ BitVec 8))
(assert (distinct i0 i1))
(assert (distinct i1 i2))
(assert (distinct i0 i2))
(assert (bvult v0 #x80))
(assert (bvugt v1 #x20))
(assert (= (h (select (store (store (store A i0 v0) i1 v1) i2 #x55) i0)) (bvadd v0 #x01)))
(assert (= (select (store (store A i0 v0) i1 v1) i2) (select A i2)))
(assert (= (bvadd (select A i2) #x01) #x11))
(check-sat)
