(set-logic QF_BV)
(set-info :status sat)
(declare-const x (_ BitVec 32))
(declare-const y (_ BitVec 32))
(declare-const s (_ BitVec 32))
(assert (bvult s #x00000010))
(assert (bvugt s #x00000002))
(assert (= y (bvshl x s)))
(assert (bvult #x00000100 x))
(assert (bvult x #x00010000))
(assert (bvult y #x01000000))
(assert (bvsgt (bvxor x y) #x00001000))
(check-sat)
