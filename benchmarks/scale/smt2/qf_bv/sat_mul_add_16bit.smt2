(set-logic QF_BV)
(set-info :status sat)
(declare-const a (_ BitVec 16))
(declare-const b (_ BitVec 16))
(declare-const c (_ BitVec 16))
(assert (bvugt a #x0003))
(assert (bvult a #x0020))
(assert (bvugt b #x0005))
(assert (bvult b #x0020))
(assert (= c (bvmul a b)))
(assert (= (bvadd c (bvand a b)) #x0134))
(check-sat)
