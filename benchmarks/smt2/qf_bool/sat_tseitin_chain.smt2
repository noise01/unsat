(set-logic QF_BOOL)
(set-info :status sat)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const d Bool)
(declare-const e Bool)
(assert (or a b))
(assert (=> a (xor b c)))
(assert (= c (and d (not e))))
(assert (or (not b) e))
(assert (ite d (or a (not c)) b))
(check-sat)
