(set-logic QF_AUFLIA)
(set-info :status unsat)
(define-sort Table (K V) (Array K V))
(define-sort IntMap () (Table Int Int))
(define-fun bounded ((x Int) (lo Int) (hi Int)) Bool (and (<= lo x) (<= x hi)))
(declare-const tbl IntMap)
(declare-const k Int)
(assert (! (bounded k 10 20) :named bounds_k))
(assert (! (= (select (store tbl k 7) k) 8) :named row1_clash))
(assert (! (= (select tbl 0) 0) :named unrelated))
(check-sat)
(get-unsat-core)
