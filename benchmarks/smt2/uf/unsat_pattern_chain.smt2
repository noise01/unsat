(set-logic UF)
(set-info :status unsat)
(declare-sort U 0)
(declare-fun f (U) U)
(declare-fun g (U) U)
(declare-fun P (U) Bool)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(assert (forall ((x U)) (! (P (f (g x))) :pattern ((f (g x))))))
(assert (= (g a) b))
(assert (= (f b) c))
(assert (not (P c)))
(check-sat)
