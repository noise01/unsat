(set-info :status sat)
(set-logic QF_UFBV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(declare-fun f ((_ BitVec 32)) (_ BitVec 32))
(assert (bvuge x #x00000010))
(assert (bvule x #x00000014))
(assert (= y x))
(assert (= (f x) #x000000ff))
(assert (= (f y) (bvor #x000000f0 #x0000000f)))
(assert (= ((_ extract 7 0) (bvadd (f y) #x00000001)) #x00))
(check-sat)
(exit)
