(set-info :status unsat)
(set-logic QF_UFBV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(declare-fun f ((_ BitVec 32)) (_ BitVec 32))
(declare-fun g ((_ BitVec 32)) (_ BitVec 32))
(assert (bvuge x #x00000100))
(assert (bvule x #x00000100))
(assert (= y (bvadd #x000000ff #x00000001)))
(assert (= (f x) (g y)))
(assert (distinct (f y) (g x)))
(check-sat)
(exit)
