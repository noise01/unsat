(set-logic QF_AX)
(set-info :status sat)
(declare-sort Idx 0)
(declare-sort Elem 0)
(declare-const a (Array Idx Elem))
(declare-const b (Array Idx Elem))
(declare-const i Idx)
(declare-const j Idx)
(declare-const v Elem)
(declare-const w Elem)
(assert (= b (store (store a i v) j w)))
(assert (distinct i j))
(assert (= (select b i) v))
(assert (distinct a b))
(check-sat)
