(set-logic QF_AX)
(set-info :status unsat)
(declare-sort Idx 0)
(declare-sort Elem 0)
(declare-const a (Array Idx Elem))
(declare-const b (Array Idx Elem))
(declare-const i Idx)
(declare-const j Idx)
(assert (= (store a i (select b i)) (store b i (select b i))))
(assert (= (select a i) (select b i)))
(assert (distinct (select a j) (select b j)))
(check-sat)
