(set-logic QF_AUFBV)
(set-info :status unsat)
(declare-const x (_ BitVec 4))
(declare-const z (_ BitVec 4))
(declare-const b0 Bool)
(declare-const A (Array (_ BitVec 4) (_ BitVec 4)))
(declare-fun P ((_ BitVec 4)) Bool)
(assert (not (P x)))
(assert (= (store ((as const (Array (_ BitVec 4) (_ BitVec 4))) #x0) x x) (store A z x)))
(assert (P z))
(assert (and b0 (not (= ((as const (Array (_ BitVec 4) (_ BitVec 4))) #x0) (store A z x)))))
(check-sat)
